{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yamagani/agent-platform/schemas/factory-request.schema.json",
  "title": "Spec-to-PR Factory change request",
  "description": "The contract a customer repository supplies at .factory/request.yaml. Validated at intake; failures are reported with the offending path rather than guessed around.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "factory/v1" },
    "kind": { "const": "ChangeRequest" },
    "metadata": {
      "type": "object",
      "required": ["title", "requestedBy"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 8, "maxLength": 120 },
        "requestedBy": { "type": "string", "format": "email" },
        "ticket": { "type": "string", "description": "Optional tracker reference carried into the PR body" },
        "labels": { "type": "array", "items": { "type": "string" }, "maxItems": 10 }
      }
    },
    "spec": {
      "type": "object",
      "required": ["goal", "inScope", "acceptanceCriteria", "targetBranch", "testCommands", "definitionOfDone"],
      "additionalProperties": false,
      "properties": {
        "goal": {
          "type": "string", "minLength": 20,
          "description": "One paragraph on the outcome wanted, in the requester's own words. Not a solution."
        },
        "inScope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "outOfScope": { "type": "array", "items": { "type": "string" } },
        "acceptanceCriteria": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "given", "when", "then"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^AC[0-9]+$" },
              "given": { "type": "string" },
              "when": { "type": "string" },
              "then": { "type": "string" }
            }
          }
        },
        "constraints": {
          "type": "array", "items": { "type": "string" },
          "description": "Hard limits the design must respect, e.g. no new datastore."
        },
        "targetBranch": { "type": "string", "default": "main" },
        "branchPrefix": { "type": "string", "default": "factory/", "pattern": "^[a-z0-9._/-]+/$" },
        "testCommands": {
          "type": "object",
          "required": ["unit"],
          "additionalProperties": false,
          "properties": {
            "unit": { "type": "string" },
            "functional": { "type": "string" },
            "lint": { "type": "string" },
            "setup": { "type": "string", "description": "Runs in the egress-allowed prepare phase only." }
          }
        },
        "definitionOfDone": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxUsd": { "type": "number", "exclusiveMinimum": 0, "default": 25 },
            "maxDurationHours": { "type": "integer", "minimum": 1, "default": 48 },
            "onExceed": { "enum": ["park", "abort"], "default": "park" }
          }
        },
        "gates": {
          "type": "object",
          "description": "Which human gates are active. Requirements and design gates cannot be disabled.",
          "additionalProperties": false,
          "properties": {
            "prePush": { "type": "boolean", "default": false },
            "approvers": { "type": "array", "items": { "type": "string", "format": "email" } },
            "expiryDays": { "type": "integer", "minimum": 1, "maximum": 30, "default": 14 }
          }
        },
        "models": {
          "type": "object",
          "description": "Optional per-stage model override. Omit to use platform defaults.",
          "additionalProperties": {
            "type": "object",
            "required": ["provider", "model"],
            "properties": {
              "provider": { "enum": ["bedrock", "anthropic", "openai", "google"] },
              "model": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
