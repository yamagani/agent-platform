# Copy to .env.local for `npm run demo`. Not read by the deployed Lambdas — those get
# config from CDK context / environment variables set on the stack (see lib/factory-stack.ts).

# --- Recon: leave unset to use the bundled fixture repo instead of a real GitHub call ---
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# --- Analyst: leave unset (or "mock") to use the deterministic mock model ---
FACTORY_LLM_PROVIDER=mock
# FACTORY_LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-20260101-v1:0
AWS_REGION=us-east-1
